# Copy to backend/.env for local runs (never commit real values).
AUTH_MODE=dev                      # dev | oidc
ENVIRONMENT=local
PUBLIC_BASE_URL=http://localhost:8080
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# OIDC (AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_AUDIENCES=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile email
OIDC_UI_TOKEN=access               # access | id
OIDC_GROUPS_CLAIM=groups
PUBLISHER_GROUP=artifact-publishers
ADMIN_GROUP=artifact-admins
ADMIN_EMAILS=                      # comma list; admins without a groups claim (Google)
ALLOWED_EMAIL_DOMAINS=

STORE_BACKEND=memory               # memory | firestore
GOOGLE_CLOUD_PROJECT=demo-artifact-hub
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8681

EMBEDDING_PROVIDER=fake            # fake | vertex
RENDER_TICKET_SECRET=              # required with AUTH_MODE=oidc
