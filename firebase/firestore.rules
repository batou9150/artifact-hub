rules_version = '2';
// Browsers never read or write Firestore directly: the web app authenticates with
// the organisation's OIDC provider, whose tokens Firestore security rules cannot
// evaluate, and every access decision lives in backend/artifact_hub/access.py.
// The Cloud Run service account (server client library, IAM-authorised) bypasses
// these rules; everything else is denied.
//
// Deviation from the reference implementation, where the SPA read artifacts live
// through onSnapshot under Firebase Auth rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
